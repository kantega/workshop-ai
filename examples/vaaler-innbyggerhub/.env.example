# Kopier til .env.local. Uten fila kjører hubben i mock-modus mot ingenting.

# mock (default) eller verifier
PLATFORM_MODE=mock

# Riggen lokalt. Bruker du KS-portene fra apps/ks-hackathon/OPPSTART.md: studio på 8060.
BEVISSTUDIO_URL=http://localhost:8080
VERIFIER_URL=http://localhost:8095

# Integrasjonsklient registrert i Bevis Studio (Organisasjon → Integrasjonsklienter, client_secret).
# Tomme = ingen legitimasjon, som mot en lokal rigg i dev-unauthenticated.
EIDAS_CLIENT_ID=
EIDAS_CLIENT_SECRET=

# Sett denne for å bruke en fremvisningsregel laget i Bevis Studio i stedet for at hubben rigger sin egen.
VERIFICATION_RULE_ID=
VERIFICATION_RULE_NAME=Våler innbyggerhub

# Hubbens egen adresse (same-device-fortsettelse etter deling).
PUBLIC_BASE_URL=http://localhost:3000
