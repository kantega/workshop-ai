# Kopier til .env.local (gitignored) og fyll inn. Verdiene leses BARE av dev-serveren
# (server/platform-auth.ts) — de når aldri nettleseren.

# Integrasjonsklienten din i testmiljøet. Registreres i kontrollflata:
#   https://design.dev2.bevisstudio.no → Organisasjon → Integrasjonsklienter → «client_secret».
# Hemmeligheten vises én gang. Se README.md for scopene appen trenger.
EIDAS_CLIENT_ID=cli_…
EIDAS_CLIENT_SECRET=cs_…

# Plattformen i testmiljøet. Standardverdiene er de som var i drift 2026-09-09; endre dem bare
# hvis miljøet flytter. Verifier-adressen må stå i `resources_supported` hos bevisstudio.
# EIDAS_STUDIO_URL=https://bevisstudio.agreeabledune-b07a297d.norwayeast.azurecontainerapps.io
# EIDAS_VERIFIER_URL=https://verifier.agreeabledune-b07a297d.norwayeast.azurecontainerapps.io

# KS-sandkassen (github.com/ks-no/workshop-ai) kjører lokalt, på portene deres.
# KS_PORT_SANDBOX=8080
# KS_PORT_TOOLS=8083
